# Supabase Client (Required at build time for Vite client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Server (Required at runtime for Vercel Serverless Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# AI Provider (Required for AI Tailor / CV analysis features)
AI_PROVIDER=groq
AI_API_KEY=gsk_...
AI_MODEL=llama-3.1-8b-instant
AI_FALLBACK_MODEL=llama-3.1-8b-instant
